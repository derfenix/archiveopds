# Example for /etc/archiveopds/environment
#   sudo install -d -m 755 /etc/archiveopds
#   sudo cp archiveopds.env.example /etc/archiveopds/environment
#   sudo chmod 600 /etc/archiveopds/environment
#   sudo nano /etc/archiveopds/environment

ARCHIVEOPDS_LISTEN=:8080
ARCHIVEOPDS_BASE_URL=http://127.0.0.1:8080
ARCHIVEOPDS_ARCHIVE=/path/to/library/root
ARCHIVEOPDS_LOG_LEVEL=info

# Optional:
# ARCHIVEOPDS_STRICT_INDEX=1
# ARCHIVEOPDS_EXPOSE_ERRORS=1
# ARCHIVEOPDS_RATE_LIMIT_RPS=10
# ARCHIVEOPDS_RATE_LIMIT_PER_IP=1
# ARCHIVEOPDS_RATE_LIMIT_TRUST_FORWARD=0
# ARCHIVEOPDS_RATE_LIMIT_MAX_TRACKED_IPS=4096
# ARCHIVEOPDS_MAX_OPEN_ZIP_VOLUMES=512
# ARCHIVEOPDS_ANNOTATION_WORKERS=4
